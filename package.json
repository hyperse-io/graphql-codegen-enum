{
  "name": "@hyperse/graphql-codegen-enum",
  "version": "1.0.5",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "lint-staged-files": "lint-staged --allow-empty",
    "codegen": "graphql-codegen --config ./codegen.cjs",
    "g:cz": "cz",
    "g:changeset": "changeset",
    "g:version": "changeset version",
    "g:release": "yarn build && changeset publish",
    "prepare": "yarn husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "^6.x"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^7.4.2",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-codegen/typescript": "^6.1.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.6",
    "@hyperse/eslint-config-hyperse": "^2.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.13.0",
    "graphql": "^16.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "graphql": ">=16.13.2"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": "please-use-yarn",
    "yarn": ">=1.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.18.1",
  "typescript": {
    "definition": "typings/index.d.ts"
  }
}
